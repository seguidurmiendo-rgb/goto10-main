      "notes": "IMPORTANTE: Para limitar a tu carpeta 'Curso de isntructor de tiro', puedes añadir a la query:\n'ID_DE_TU_CARPETA' in parents"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"files\": {{$json}}\n}",
        "options": {}
      },
